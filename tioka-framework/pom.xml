<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tioka</groupId>
        <artifactId>tioka</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>tioka-framework</artifactId>
    <name>tioka-framework</name>
    <dependencies>
        <!-- F-02 BAS-26 第 1 步：Tioka 开始依赖 Foundation 工程底座。
             版本由 tioka-dependencies 导入的 foundation-dependencies BOM 管理；
             CoreAutoConfiguration 仅绑定 foundation.* 配置属性，不接管 Jackson/异常处理。 -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-core</artifactId>
        </dependency>
        <!-- F-02 BAS-26 第 1 步（core 子步骤 1a）：主键生成统一到 Foundation 公共域。
             全仓 Ids.newId 调用方已改引 com.foundation.common.id.Ids，Tioka 本地副本删除。
             显式声明而非依赖 starter-core 的传递，便于 dependency:analyze 与后续升级。 -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-common-api</artifactId>
        </dependency>
        <!-- F-02 BAS-26 第 2 步（data）：persistence 的 4 个通用 DO 基类合流到 starter-data。
             空间过滤（ScopeLineHandler / ScopedTables / WorkspaceAwareDO / WorkspaceScoped）、
             TiokaMetaObjectHandler 与 MybatisPlusConfiguration 等 Tioka 特有部分仍留在本地。
             注意：starter 的自动装配默认激活（foundation.data.enabled 缺省 true），会尝试注册
             MetaObjectHandler / MybatisPlusInterceptor，与 Tioka 本地实现并存；故 application.yml
             显式置 foundation.data.enabled=false，只取用其 POJO 基类，待该能力真正迁移时再打开。 -->
        <dependency>
            <groupId>com.foundation</groupId>
            <artifactId>foundation-starter-data</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.f4b6a3</groupId>
            <artifactId>ulid-creator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
