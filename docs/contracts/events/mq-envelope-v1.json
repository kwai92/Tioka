{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tioka.dev/schema/mq-envelope-v1.json",
  "title": "Cross-domain MQ event envelope v1 (ADR-020, ADR-029 #15)",
  "description": "Every message published via sys_outbox to RocketMQ. Topic/event name pattern: tioka.{domain}.{event}.v{n}. Incompatible payload changes must bump the version suffix.",
  "type": "object",
  "required": ["eventId", "event", "schemaVersion", "tenantId", "occurredAt", "producer", "payload"],
  "properties": {
    "eventId": { "type": "string", "description": "ULID; consumers dedupe via sys_consumed(consumer, event_id)." },
    "event": { "type": "string", "pattern": "^tioka\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.]*\\.v[0-9]+$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "tenantId": { "type": "string" },
    "workspaceId": { "type": "string" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "description": "Producing module, e.g. orchestration-biz." },
    "traceId": { "type": "string" },
    "subjectKey": { "type": "string", "description": "Ordering / grouping key (RocketMQ message group)." },
    "hops": { "type": "integer", "minimum": 0, "description": "Derived-event depth; orchestration rejects beyond its limit." },
    "runAs": {
      "type": "object",
      "description": "Identity only, no permission set (ADR-029 #6).",
      "required": ["tenantId", "userId", "type"],
      "properties": {
        "tenantId": { "type": "string" },
        "userId": { "type": "string" },
        "workspaceId": { "type": "string" },
        "type": { "enum": ["USER", "SERVICE", "SYSTEM"] }
      }
    },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
