{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tioka.local/contracts/agent/agent-spec-v1.json",
  "title": "AgentSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "instructions",
    "model",
    "tools",
    "skills",
    "knowledge",
    "sandbox",
    "approval",
    "limits"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "profile": { "$ref": "#/$defs/Profile" },
    "instructions": { "$ref": "#/$defs/Instructions" },
    "model": { "$ref": "#/$defs/ModelPolicy" },
    "tools": { "$ref": "#/$defs/ToolSet" },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/SkillRef" }
    },
    "knowledge": { "$ref": "#/$defs/KnowledgeBinding" },
    "sandbox": { "$ref": "#/$defs/SandboxPolicy" },
    "approval": { "$ref": "#/$defs/ApprovalSettings" },
    "limits": { "$ref": "#/$defs/Limits" },
    "charter": { "type": ["object", "null"] },
    "output": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/OutputContract" }
      ]
    },
    "subAgents": { "type": ["object", "null"] },
    "dataClearance": { "type": ["string", "null"] }
  },
  "$defs": {
    "OutputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaRef", "mode"],
      "properties": {
        "schemaRef": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["FINAL", "TOOL"] },
        "maxRepair": { "type": "integer", "minimum": 0, "default": 2 },
        "requireEvidence": { "type": "boolean", "default": false },
        "strategy": {
          "type": "string",
          "enum": ["DIRECT", "REASON_THEN_FORMAT"],
          "default": "DIRECT"
        },
        "formatModelAlias": { "type": ["string", "null"] }
      }
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "icon": { "type": ["string", "null"] },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "kind": { "type": "string", "enum": ["CHAT", "TASK", "READONLY"] }
      }
    },
    "Instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "text"],
            "properties": {
              "key": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "ModelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routingPlanId"],
      "properties": {
        "routingPlanId": { "type": "string", "minLength": 1 },
        "allowUserOverride": { "type": "boolean", "default": false }
      }
    },
    "ToolSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "builtin": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["serverId", "allowlist"],
            "properties": {
              "serverId": { "type": "string" },
              "allowlist": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "flows": {
          "type": "array",
          "items": {}
        },
        "business": {
          "type": "array",
          "items": {}
        }
      }
    },
    "SkillRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillVersionId", "mode"],
      "properties": {
        "skillVersionId": { "type": "string" },
        "mode": { "type": "string", "enum": ["ALWAYS", "MANUAL"] }
      }
    },
    "KnowledgeBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kbIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mode": { "type": "string", "enum": ["TOOL", "AUTO_RETRIEVE"] }
      }
    },
    "SandboxPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "type": "string", "enum": ["READ", "EDIT", "FULL"] },
        "networkAllowlist": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ApprovalSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolPolicies": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["auto", "approve", "deny"]
          }
        },
        "assignee": { "type": ["string", "null"] }
      }
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSteps": { "type": "integer", "minimum": 1, "default": 20 },
        "maxTokensPerTurn": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
