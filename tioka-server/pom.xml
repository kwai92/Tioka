<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tioka</groupId>
        <artifactId>tioka</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>tioka-server</artifactId>
    <name>tioka-server</name>
    <dependencies>
        <dependency>
            <groupId>com.tioka</groupId>
            <artifactId>tioka-module-system-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tioka</groupId>
            <artifactId>tioka-module-infra-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- W0 起装入空域模块以便 ArchUnit 扫描全仓包 -->
        <dependency>
            <groupId>com.tioka</groupId>
            <artifactId>tioka-module-runtime-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tioka</groupId>
            <artifactId>tioka-module-connector-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tioka</groupId>
            <artifactId>tioka-module-model-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tioka</groupId>
            <artifactId>tioka-module-agent-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tioka</groupId>
            <artifactId>tioka-module-mcp-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tioka</groupId>
            <artifactId>tioka-module-skill-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tioka</groupId>
            <artifactId>tioka-module-chat-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tioka</groupId>
            <artifactId>tioka-module-orchestration-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tioka</groupId>
            <artifactId>tioka-module-knowledge-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tioka</groupId>
            <artifactId>tioka-module-flow-biz</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
