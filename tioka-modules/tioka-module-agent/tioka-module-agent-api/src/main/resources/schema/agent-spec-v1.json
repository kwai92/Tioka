{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tioka.local/contracts/agent/agent-spec-v1.json",
  "title": "AgentSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "instructions",
    "model",
    "tools",
    "skills",
    "knowledge",
    "sandbox",
    "approval",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "instructions": {
      "$ref": "#/$defs/Instructions"
    },
    "model": {
      "$ref": "#/$defs/ModelPolicy"
    },
    "tools": {
      "$ref": "#/$defs/ToolSet"
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SkillRef"
      }
    },
    "knowledge": {
      "$ref": "#/$defs/KnowledgeBinding"
    },
    "sandbox": {
      "$ref": "#/$defs/SandboxPolicy"
    },
    "approval": {
      "$ref": "#/$defs/ApprovalSettings"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "charter": {
      "type": [
        "object",
        "null"
      ]
    },
    "output": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/OutputContract"
        }
      ]
    },
    "prompt": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/PromptRef"
        }
      ]
    },
    "context": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ContextSettings"
        }
      ]
    },
    "memory": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/MemorySettings"
        }
      ]
    },
    "execution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ExecutionSettings"
        }
      ]
    },
    "subAgents": {
      "description": "MAS-01..03 / C-20 解冻：可委派子 Agent 白名单，由 DelegateToolProvider 消费",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed"],
          "properties": {
            "allowed": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "dataClearance": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "SECRET",
        null
      ]
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "DAT-01：绑定的数据集名（SERVICE 模式须全部有 ENFORCE 策略）"
    }
  },
  "$defs": {
    "PromptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateId"
      ],
      "properties": {
        "templateId": {
          "type": "string",
          "minLength": 1
        },
        "pinnedVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "ContextSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budgetTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "cleanupThresholdPercent": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "keepRecentTurns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "neverCleanupTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summaryHint": {
          "type": [
            "string",
            "null"
          ]
        },
        "childPassMode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ISOLATED",
            "WITH_SUMMARY"
          ]
        },
        "childReturnTokenLimit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "MemorySettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readScope": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "NONE",
            "USER",
            "SPACE",
            "USER_AND_SPACE"
          ]
        },
        "writeMode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "NONE",
            "EXPLICIT_ONLY",
            "AUTO"
          ]
        },
        "defaultAgentAffinity": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "ExecutionSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": [
            "string",
            "null"
          ]
        },
        "strategyParams": {
          "type": [
            "object",
            "null"
          ]
        },
        "executor": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowRuntimeOverride": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "OutputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaRef",
        "mode"
      ],
      "properties": {
        "schemaRef": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "FINAL",
            "TOOL"
          ]
        },
        "maxRepair": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        },
        "requireEvidence": {
          "type": "boolean",
          "default": false
        },
        "strategy": {
          "type": "string",
          "enum": [
            "DIRECT",
            "REASON_THEN_FORMAT"
          ],
          "default": "DIRECT"
        },
        "formatModelAlias": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "CHAT",
            "TASK",
            "READONLY"
          ]
        }
      }
    },
    "Instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "text"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ModelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routingPlanId"
      ],
      "properties": {
        "routingPlanId": {
          "type": "string",
          "minLength": 1
        },
        "allowUserOverride": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ToolSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "builtin": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serverId",
              "allowlist"
            ],
            "properties": {
              "serverId": {
                "type": "string"
              },
              "allowlist": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "flows": {
          "type": "array",
          "items": {}
        },
        "business": {
          "type": "array",
          "items": {}
        }
      }
    },
    "SkillRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillVersionId",
        "mode"
      ],
      "properties": {
        "skillVersionId": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "ALWAYS",
            "MANUAL"
          ]
        }
      }
    },
    "KnowledgeBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kbIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "TOOL",
            "AUTO_RETRIEVE"
          ]
        }
      }
    },
    "SandboxPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "READ",
            "EDIT",
            "FULL"
          ]
        },
        "networkAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ApprovalSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolPolicies": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "auto",
              "approve",
              "deny"
            ]
          }
        },
        "assignee": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSteps": {
          "type": "integer",
          "minimum": 1,
          "default": 20
        },
        "maxTokensPerTurn": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}