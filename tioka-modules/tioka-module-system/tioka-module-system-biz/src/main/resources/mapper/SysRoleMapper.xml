<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tioka.system.infrastructure.mapper.SysRoleMapper">

    <select id="findByCode" resultType="SysRoleDO">
        <![CDATA[
            SELECT code, name, scope, builtin
            FROM sys_role
            WHERE code = #{code} AND deleted = FALSE
            
]]>
    </select>

    <select id="listAll" resultType="SysRoleDO">
        <![CDATA[
            SELECT code, name, scope, builtin
            FROM sys_role
            WHERE deleted = FALSE
            ORDER BY builtin DESC, code
            
]]>
    </select>

</mapper>
